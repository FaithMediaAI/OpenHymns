{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FaithMediaAI/OpenHymns/schemas/canonical.schema.json",
  "title": "OpenHymns Unique Song Catalog",
  "type": "array",
  "items": {
    "allOf": [
      {
        "$ref": "hymn.schema.json"
      },
      {
        "type": "object",
        "required": [
          "canonicalId",
          "collectionIds",
          "alternateTitles",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^song-[a-f0-9]+$"
          }
        }
      }
    ]
  }
}
