{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FaithMediaAI/OpenHymns/schemas/collection.schema.json",
  "title": "OpenHymns Collection",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "language",
    "version",
    "source",
    "hymnCount",
    "hymns",
    "sourceHymnCount",
    "membershipCount"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "repo",
        "url",
        "path",
        "license",
        "rightsStatus",
        "publishable"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "rightsStatus": {
          "type": "string"
        },
        "publishable": {
          "type": "boolean"
        }
      }
    },
    "hymnCount": {
      "type": "integer"
    },
    "hymns": {
      "type": "array",
      "items": {
        "$ref": "hymn.schema.json"
      }
    },
    "sourceHymnCount": {
      "type": "integer",
      "minimum": 0
    },
    "membershipCount": {
      "type": "integer",
      "minimum": 0
    }
  }
}
