{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FaithMediaAI/OpenHymns/schemas/manifest.schema.json",
  "title": "OpenHymns Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "generatedAt",
    "collectionCount",
    "hymnCount",
    "collections",
    "indexes",
    "canonicalHymnCount",
    "quarantine",
    "qualityReport",
    "sourceHymnCount",
    "catalogMode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "collectionCount": {
      "type": "integer"
    },
    "hymnCount": {
      "type": "integer"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "language",
          "hymnCount",
          "path",
          "sha256",
          "license",
          "rightsStatus",
          "publishable",
          "sourceRepo",
          "sourceHymnCount",
          "membershipCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "hymnCount": {
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "rightsStatus": {
            "type": "string"
          },
          "publishable": {
            "type": "boolean"
          },
          "sourceRepo": {
            "type": "string"
          },
          "sourceHymnCount": {
            "type": "integer",
            "minimum": 0
          },
          "membershipCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "sha256",
          "recordCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "recordCount": {
            "type": "integer"
          }
        }
      }
    },
    "warnings": {
      "type": "array"
    },
    "canonicalHymnCount": {
      "type": "integer",
      "minimum": 0
    },
    "qualityReport": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "quarantine": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "recordCount"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceHymnCount": {
      "type": "integer",
      "minimum": 0
    },
    "catalogMode": {
      "const": "one-song-per-language"
    }
  }
}
