      "language": "lu",
      "number": "",
      "schemaVersion": 1,
      "searchText": "mtakatifu, mtakatifu, mtakatifu in luo reginald heber u mtakatifu...! mungu mwenyezi! alfajiri sifa zako tutaimba; u mtakatifu, bwana wa huruma. mungu wavyote hata milele umtakatifu! na malaika wengi sana wana kuabudu wote; elfu na maelfu wana kusujudu wazamani na hata milele. u mtakatifu! ingawa giza lakuficha fahari tusiioone, u mtakatifu! wewe peke yako, kamili kwa uwezo na pendo.",
      "sections": [
        {
          "label": "1",
          "lines": [
            "U Mtakatifu...! Mungu Mwenyezi!",
            "Alfajiri Sifa Zako Tutaimba;",
            "U Mtakatifu, Bwana Wa Huruma.",
            "Mungu Wavyote Hata Milele"
          ],
          "type": "verse"
        },
        {
          "label": "2",
          "lines": [
            "Umtakatifu! Na Malaika",
            "Wengi Sana Wana Kuabudu Wote;",
            "Elfu Na Maelfu Wana Kusujudu",
            "Wazamani Na Hata Milele."
          ],
          "type": "verse"
        },
        {
          "label": "3",
          "lines": [
            "U Mtakatifu! Ingawa Giza",
            "Lakuficha Fahari Tusiioone,",
            "U Mtakatifu! Wewe Peke Yako,",
            "Kamili Kwa Uwezo Na Pendo."
          ],
          "type": "verse"
        }
      ],
